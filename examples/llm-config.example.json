{
  "default_provider": "local",
  "roles": {
    "agent_decision": {"provider": "local", "max_completion_tokens": 512, "max_agent_iterations": 3},
    "agent_reflection": {"provider": "local", "max_completion_tokens": 1024, "max_agent_iterations": 4},
    "story": {"max_completion_tokens": 512, "max_agent_iterations": 3},
    "god": {"provider": "remote", "max_completion_tokens": 1024, "max_agent_iterations": 4},
    "world_builder": {"provider": "remote", "max_completion_tokens": 4096, "max_agent_iterations": 6}
  },
  "providers": {
    "local": {
      "type": "openai_compatible",
      "base_url": "http://127.0.0.1:8192/v1",
      "model": "local-model",
      "api_key_env": null,
      "timeout_seconds": 120,
      "max_retries": 2,
      "retry_backoff_seconds": 1.0
    },
    "remote": {
      "type": "openai_compatible",
      "base_url": "https://opencode.ai/inference/go/openai/v1",
      "model": "beam-free",
      "api_key_env": "MY_MY_API",
      "timeout_seconds": 120,
      "max_retries": 2,
      "retry_backoff_seconds": 1.0
    }
  }
}
